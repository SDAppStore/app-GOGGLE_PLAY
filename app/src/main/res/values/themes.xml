<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GogglePlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/goggle_blue</item>
        <item name="colorPrimaryVariant">@color/goggle_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/goggle_blue</item>
        <item name="colorSecondaryVariant">@color/goggle_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
    <style name="ShapeAppearanceOverlay.GogglePlay.AppIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="DetailsMetric">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/goggle_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DetailsDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@color/goggle_divider</item>
    </style>
</resources>
